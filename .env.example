# Copy to .env.local for local development (`npm run dev`), and add the same keys in
# Vercel → Project → Settings → Environment Variables. They are read only by the /api functions and never reach the browser.

# --- Cloud storage (Upstash Redis → your database → "REST API") ----------------------------------
# Without these two the app runs in clearly labelled demo mode: edits stay in the visitor's browser.
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Owner passphrase (required to edit) ----------------------------------------------------------
# Entered once in the editor to open a 7-day session. If it is empty, NOBODY can save to the cloud.
# Use a long random phrase. Changing it signs every device out.
JOURNEY_EDIT_TOKEN=

# --- Optional -------------------------------------------------------------------------------------
# Extra entropy for session signing (rotate to sign everyone out without changing the passphrase).
JOURNEY_SESSION_SECRET=
# Place search: any Photon-compatible endpoint. Default is the public instance (fair-use limits apply).
GEOCODER_URL=https://photon.komoot.io/api
GEOCODER_USER_AGENT=
# Weather provider endpoints (Open-Meteo by default).
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
