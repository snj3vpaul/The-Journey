# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# These are read ONLY by api/journey.js and never reach the browser.

# Upstash Redis → your database → "REST API" section
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional but recommended: a passphrase required to save edits.
# Without it, anyone who can open the page can change the journey.
JOURNEY_EDIT_TOKEN=
